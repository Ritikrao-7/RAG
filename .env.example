# Copy to .env and fill in. Never commit .env.
GOOGLE_API_KEY=your-gemini-api-key
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=brand-qa
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Check these against the current Gemini model list
CHAT_MODEL=gemini-3.1-flash-lite
EMBEDDING_MODEL=gemini-embedding-001

# Must equal the Pinecone index dimension
EMBEDDING_DIMENSIONS=768

LLM_TIMEOUT_SECONDS=60

# Public deployment (set these in the Vercel project settings)
# Postgres for demo users, e.g. Neon's pooled connection string. Empty keeps users in memory.
DATABASE_URL=
REQUIRE_REGISTRATION=false
# 0 turns a limit off
REQUESTS_PER_MINUTE=0
MAX_CHUNKS_PER_TENANT=0
